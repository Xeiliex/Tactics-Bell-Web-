{
  "name": "tactics-bell",
  "version": "1.0.0",
  "description": "A light tactical battle game powered by Babylon.js, Oimo.js, and anime.js",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "start": "bun server.js",
    "dev": "bun --watch server.js",
    "start:node": "node server.js",
    "test": "node --test test/smoke-server.test.js",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=true electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.tacticsbell.game",
    "productName": "Tactics Bell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "electron-main.js",
      "electron-preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "protocols": [
      {
        "name": "Tactics Bell",
        "schemes": [
          "tacticsbell"
        ]
      }
    ]
  }
}
